<style>
  .search-btn{
    padding:0 1rem 0 1rem;
    background-color: #fe424d;
    color:#fff;
    border-radius: 25px;
  }
  .search-btn:hover{
    background-color: #fe424d;
    color:#fff;
  }
  .search-btn i{
    display: inline;
    margin-right: 0.5rem;
  }
  .search-inp{
    border-radius: 25px;
    padding: 0.5rem 3rem 0.5rem 3rem;
    font-size: 1rem;
    text-align: left;
  }

  @media (max-width: 768px) {
  .search-form {
    width: 100%;
    align-items: center;
    gap: 0.25rem; 
  }

  .search-inp {
    width: 80%;
    text-align: left;
    padding: 0.45rem 1.25rem;
    font-size: 0.95rem;
  }

  .search-btn {
    width: auto;
    padding: 0.45rem 1.25rem;
    font-size: 0.9rem;
     
  }
}

.search-inp::placeholder {
  color: #999;
}


.brand-text {
  font-size: 1.35rem;
  font-weight: 700;
  letter-spacing: 0.5px;
  color: #fe424d;
  position: relative;
  top: auto; 
}



</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand brand" href="/listings"><i class="fa-regular fa-compass"></i> <span class="brand-text">RoamNest</span></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav ms-auto">
        <form class="d-flex flex-column d-md-flex flex-md-row gap-2 search-form" role="search"  action="/listings" method="GET">
        <input class="form-control me-2 search-inp" type="search" placeholder="Search destinations"  name="country" list="countries"/>
        <datalist id="countries">
        <option value="India">
        <option value="United States">
        <option value="Italy">
        <option value="Mexico">
        <option value="Indonesia">
        <option value="Greece">
        <option value="Switzerland">
    </datalist>
        <button class="btn search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
      </form>
      </div>
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">List your place</a>
        <% if (!currUser) {%>
          <a class="nav-link" href="/signup"><b>Sign up</b></a>
          <a class="nav-link" href="/login"><b>Log in</b></a>
        <%}%>
        <%if(currUser) { %>
          <a class="nav-link" href="/logout"><b>Log out</b></a>
        <%}%>
      </div>
    </div>
  </div>
</nav>